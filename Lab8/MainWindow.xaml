<Window x:Class="Lab8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Багатовіконний редактор" Height="500" Width="800"
        Initialized="Window_Initialized">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Command="ApplicationCommands.Open" Content="Відкрити" ToolTip="Відкрити"/>
            <Button Command="ApplicationCommands.Save" Content="Зберегти" ToolTip="Зберегти"/>
            <Button Click="AddTab_Click" Content="Нова вкладка" ToolTip="Нова вкладка"/>
            <Button Click="InsertImage_Click" Content="Вставити зображення" ToolTip="Вставити зображення"/>
            <Separator/>
            <ToggleButton Command="EditingCommands.ToggleBold" Name="btnBold" Content="Ж" FontWeight="Bold" ToolTip="Жирний"/>
            <ToggleButton Command="EditingCommands.ToggleItalic" Name="btnItalic" Content="К" FontStyle="Italic" ToolTip="Курсив"/>
            <ToggleButton Command="EditingCommands.ToggleUnderline" Name="btnUnderline" Content="П" ToolTip="Підкреслення">
                <ToggleButton.Resources>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                    </Style>
                </ToggleButton.Resources>
            </ToggleButton>
            <Separator/>
            <ComboBox Name="cmbFontFamily" Width="150" SelectionChanged="cmbFontFamily_SelectionChanged"/>
            <ComboBox Name="cmbFontSize" Width="50" IsEditable="True" SelectionChanged="cmbFontSize_SelectionChanged" Loaded="cmbFontSize_Loaded"/>
        </ToolBar>
        <TabControl Name="tabControl" SelectionChanged="TabControl_SelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Документ 1"/>
                        <Button Content="×" Width="20" Height="20" Margin="5,0,0,0"
                                Padding="0" Click="CloseTab_Click"/>
                    </StackPanel>
                </TabItem.Header>
                <RichTextBox Name="rtbEditor" SelectionChanged="rtbEditor_SelectionChanged"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>